[comment] {----------------------------------------------------- Clases ----------------------------------------------------------}

#class TableBasedValueSolver {
  #begin-construction
  #method:solve {
    [run]{ [variable] first{#this.firstValue} }
    [run]{ [variable] second{#this.secondValue} }
    [run]{ [variable] combined{ [execute] first $solver:op $second } }
   	[run]{ [variable] solver:result{ [execute] combined} }
  }
  #property:firstValue  { [execute] solver:p1 }
  #property:secondValue { [execute] solver:p2 }
  #property:operator    { [execute] solver:op }
  #end-construction
}

#class Nibble {
  #begin-construction

  #method:setValue {[run]{[field] value{[execute] value}}}

  #method:dec{
    [run]{ [variable] solver:p1{#this.value} }
    [run]{ [variable] solver:p2{1} }
    [run]{ [variable] solver:op{_-_} }
    [run]{ [variable] instance:name{solver1} }
    [run]{ [create] TableBasedValueSolver }
    [run]{ [execute] solver1.solve }
   	[run]{ [variable] dec:result{ [execute] solver:result} }
  }
  #method:inc{
    [run]{ [variable] solver:p1{#this.value} }
    [run]{ [variable] solver:p2{1} }
    [run]{ [variable] solver:op{_+_} }
    [run]{ [variable] instance:name{solver1} }
    [run]{ [create] TableBasedValueSolver }
    [run]{ [execute] solver1.solve }
   	[run]{ [variable] inc:result{ [execute] solver:result} }
  }
  #method:isZero{
    [run]{ [variable] solver:p1{#this.value} }
    [run]{ [variable] solver:p2{0} }
    [run]{ [variable] solver:op{_==_} }
    [run]{ [variable] instance:name{solver1} }
    [run]{ [create] TableBasedValueSolver }
    [run]{ [execute] solver1.solve }
   	[run]{ [variable] isZero:result{ [execute] solver:result} }
  }
  #method:getValue{ #this.value }
  #property:value {[execute] nibble:value }
  #end-construction
}

#class MultiplicationWhileTemplate {
  #begin-construction
  #method:condition
  {
 	[run]{[variable] b1{#this.counter.isZero}} [run]{[execute] b1}
    [run]{[variable] b2{[execute] isZero:result}}
   	[run]{[variable] condition:result{ [execute] b2} }
  }
  #method:body
  {
 	[run]{[variable] b1{#this.counter.dec}} [run]{[execute] b1}
    [run]{[variable] value{[execute]dec:result}}
    [run]{[variable] c1{#this.counter.setValue}}
	[run]{[variable] body:result{ [execute] c1} }
  }
  #property:counter { [execute]  template:counter }
  #end-construction
}

#class While {
  #begin-construction
  #property:template { [execute]  while:template }

  #method:true
  {
	[run]{[call-method]execute}
  }

  #method:execute
  {
	[run]{[variable] a1{#this.template.body}} [run]{[execute] a1}
    [run]{[variable] a1{#this.template.condition}} [run]{[execute] a1}
    [run]{[variable] b1{#this.}}
    [run]{[variable] notCondition{$condition:result.not}}
    [run]{[variable] b2{[execute] b1 $notCondition}} [run]{[execute] b2}
  }
  #end-construction
}

#class Main {
  #begin-construction
  #method:execute
  {
    [run]{ [variable] nibble:value{5} }
    [run]{ [variable] instance:name{nibble1} }
    [run]{ [create] Nibble }

    [run]{ [variable] template:counter{[execute] nibble1} }
    [run]{ [variable] instance:name{template1} }
    [run]{ [create] MultiplicationWhileTemplate }

    [run]{ [variable] while:template{[execute] template1} }
    [run]{ [variable] instance:name{while1} }
    [run]{ [create] While }

    [run]{ [execute] while1.execute }
    [run]{ [execute] nibble1.getValue }
  }
  #end-construction
}

[temp] {
  [run]{ $instance:name{main1} }
  [run]{ new Main }
  [run]{ $main1.execute }
}