[comment] {----------------------------------------------------- Program start ----------------------------------------------------- }
[comment] {------------------------------------------------------------------------------------------------------------------------- }
[comment] {------------------------------------------------------------------------------------------------------------------------- }


	#class Rectangle
	{
		#begin-construction

		#method:getArea
		{
			[run]{ [variable] multiplier:p1{#this.width} }
			[run]{ [variable] multiplier:p2{#this.height} }
			[run]{ [variable] instance:name{mult1} }
			[run]{ [create] Multiplier }
			[run]{ [execute] mult1.multiply }
			[run]{ [variable] area:result{[execute]multiply:result} }
		}

		#property:width { [execute] rectangle:width }
		#property:height { [execute] rectangle:height }

		#end-construction
	}

	#class Multiplier
	{
		#begin-construction

		#method:multiply
		{
			[run]{ [variable] multiply:first{#this.firstValue} }
			[run]{ [variable] multiply:second{#this.secondValue} }
			[run]{ [variable] multiply:combined{ [execute] multiply:first [_x_] $multiply:second} }
			[run]{ [variable] multiply:result{ [execute] multiply:combined} }
		}

		#property:firstValue { [execute] multiplier:p1 }
		#property:secondValue { [execute] multiplier:p2 }

		#end-construction
	}


	#class Main
	{
		#begin-construction

		#method:execute
		{
			[run]{ #this.m1 }
			[run]{ #this.m2 }
		}

		#method:m1
		{
			[run]{ [variable] rectangle:width{10} }
			[run]{ [variable] rectangle:height{20} }
			[run]{ [variable] instance:name{rect1} }
			[run]{ [create] Rectangle }
			[run]{ [execute] rect1.getArea }
			[run]{ [execute] area:result }
		}

		#method:m2
		{
			[run]{ [variable] rectangle:width{30} }
			[run]{ [variable] rectangle:height{40} }
			[run]{ [variable] instance:name{rect2} }
			[run]{ [create] Rectangle }
			[run]{ [execute] rect2.getArea }
			[run]{ [execute] area:result }
		}

		#end-construction
	}

	[temp]
	{
		[run]{ $instance:name{main1} }
		[run]{ new Main }
		[run]{ $main1.execute }
	}
