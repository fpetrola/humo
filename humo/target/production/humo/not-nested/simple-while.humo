[comment] {----------------------------------------------------- Clases -----------------------------------------------------}

#class TableBasedValueSolver {
  #begin-construction
  #method:solve {
    [run]{ [variable] first{#this.firstValue} }
    [run]{ [variable] second{#this.secondValue} }
    [run]{ [variable] combined{ [execute] first [_]_ $second } }
    [run]{ [execute] combined }
  }
  #property:firstValue  { [execute] solver:p1 }
  #property:secondValue { [execute] solver:p2 }
  #property:operator    { [execute] solver:op }
  #end-construction
}

#class Nibble {
  #begin-construction
  #method:setValue{value}{
    [run]{ [variable] value{value} }
  }
  #method:dec{
    [run]{ [variable] solver:p1{#this.value} }
    [run]{ [variable] solver:p2{1} }
    [run]{ [variable] solver:op{_-_} }
    [run]{ [variable] instance:name{solver1} }
    [run]{ [create] TableBasedValueSolver }
    [run]{ [execute] solver1.solve }
  }
  #method:inc{
    [run]{ [variable] solver:p1{#this.value} }
    [run]{ [variable] solver:p2{1} }
    [run]{ [variable] solver:op{_+_} }
    [run]{ [variable] instance:name{solver1} }
    [run]{ [create] TableBasedValueSolver }
    [run]{ [execute] solver1.solve }
  }
  #method:isZero{
    [run]{ [variable] solver:p1{#this.value} }
    [run]{ [variable] solver:p2{0} }
    [run]{ [variable] solver:op{_==_} }
    [run]{ [variable] instance:name{solver1} }
    [run]{ [create] TableBasedValueSolver }
    [run]{ [execute] solver1.solve }
  }
  #method:getValue{
    [execute] value
  }
  #property:value { [execute] nibble:value }
  #end-construction
}

#class MultiplicationWhileTemplate {
  #begin-construction
  #method:condition{
    [run]{ [execute] counter.isZero }
    [run]{ [execute] result.not }
  }
  #method:body{
    [run]{ [execute] counter.dec }
    [run]{ [execute] counter.setValue{ [execute] result } }
  }
  #property:counter { [execute] template:counter }
  #end-construction
}

#class While {
  #begin-construction
  #method:execute{
    [run]{ [execute] template.condition }
    [run]{ [execute] template.body }
    [run]{ [execute] while.execute }
  }
  #property:template { [execute] while:template }
  #end-construction
}

#class Main {
  #begin-construction
  #method:execute{
    [run]{ [variable] nibble:value{4} }
    [run]{ [variable] instance:name{nibble1} }
    [run]{ [create] Nibble }

    [run]{ [variable] template:counter{#ref nibble1} }
    [run]{ [variable] instance:name{template1} }
    [run]{ [create] MultiplicationWhileTemplate }

    [run]{ [variable] while:template{#ref template1} }
    [run]{ [variable] instance:name{while1} }
    [run]{ [create] While }

    [run]{ [execute] while1.execute }
    [run]{ [execute] nibble1.getValue }   resultado final en el output
  }
  #end-construction
}

[comment] {----------------------------------------------------- Inicio del programa -----------------------------------------------------}
[temp] {
  [run]{ $instance:name{main1} }
  [run]{ new Main }
  [run]{ $main1.execute }
}